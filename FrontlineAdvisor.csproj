<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>1.0.0</Version>
    <Description>Reads who is leading a Frontline match, says which Grand Company to focus and which is about to become dangerous, and calls out every change of leader.</Description>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <Author>PriestKos</Author>
    <Authors>PriestKos</Authors>
    <Name>FrontlineAdvisor</Name>
    <Punchline>Who is winning, who to hit, who is about to matter.</Punchline>
    <RepoUrl>https://github.com/priestkos/FrontlineAdvisor</RepoUrl>
    <Tags>pvp;frontline;utility;ui;notification</Tags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The offline logic harness is a separate console project; keep it out of the plugin build. -->
    <Compile Remove="tests\**" />
  </ItemGroup>

</Project>
